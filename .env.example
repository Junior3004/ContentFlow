# =============================================================================
# ContentFlow - Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# NEVER commit your real .env file or real API credentials.
# =============================================================================

# Application Settings
APP_NAME="ContentFlow"
APP_ENV="development"
APP_DEBUG=true
APP_TIMEZONE="America/Sao_Paulo"
APP_DEFAULT_LOCALE="pt-BR"

# Back-end Server (Vanilla PHP)
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
CORS_ALLOWED_ORIGIN="http://localhost:5173"

# Database (Local SQLite)
DB_CONNECTION="sqlite"
DB_DATABASE="storage/database/contentflow.sqlite"

# Front-end Server (Vite / React)
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_DEFAULT_LOCALE="pt-BR"

# Optional Social Platform API Placeholders (for future OAuth integrations)
INSTAGRAM_CLIENT_ID="your_instagram_client_id_here"
INSTAGRAM_CLIENT_SECRET="your_instagram_client_secret_here"
X_API_KEY="your_x_api_key_here"
X_API_SECRET="your_x_api_secret_here"
LINKEDIN_CLIENT_ID="your_linkedin_client_id_here"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret_here"
YOUTUBE_API_KEY="your_youtube_api_key_here"
